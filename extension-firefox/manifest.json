{
  "manifest_version": 3,
  "name": "Vinted HEIC Importer",
  "version": "1.6.15",
  "description": "Importez des photos HEIC/HEIF sur Vinted — conversion automatique en JPEG ou PNG, amélioration instantanée des photos (baguette magique) et panneau Detniv (connexion, création d'annonce, republication).",
  "browser_specific_settings": {
    "gecko": {
      "id": "detniv-heic@vinted-ext",
      "strict_min_version": "109.0"
    }
  },
  "permissions": ["storage", "cookies"],
  "background": {
    "scripts": ["background/background.js"]
  },
  "host_permissions": [
    "https://www.vinted.fr/*",
    "https://www.vinted.com/*",
    "https://www.vinted.it/*",
    "https://www.vinted.es/*",
    "https://www.vinted.de/*",
    "https://www.vinted.co.uk/*",
    "https://www.vinted.nl/*",
    "https://www.vinted.pl/*",
    "https://www.vinted.be/*",
    "https://www.vinted.pt/*",
    "https://www.vinted.lt/*",
    "https://www.vinted.lv/*",
    "https://www.vinted.cz/*",
    "https://www.vinted.sk/*",
    "https://www.vinted.hu/*",
    "https://www.vinted.ro/*",
    "https://www.vinted.at/*",
    "https://www.vinted.ch/*",
    "https://www.vinted.se/*",
    "https://www.vinted.dk/*",
    "https://www.vinted.fi/*",
    "https://www.vinted.no/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.vinted.fr/*",
        "https://www.vinted.com/*",
        "https://www.vinted.it/*",
        "https://www.vinted.es/*",
        "https://www.vinted.de/*",
        "https://www.vinted.co.uk/*",
        "https://www.vinted.nl/*",
        "https://www.vinted.pl/*",
        "https://www.vinted.be/*",
        "https://www.vinted.pt/*",
        "https://www.vinted.lt/*",
        "https://www.vinted.lv/*",
        "https://www.vinted.cz/*",
        "https://www.vinted.sk/*",
        "https://www.vinted.hu/*",
        "https://www.vinted.ro/*",
        "https://www.vinted.at/*",
        "https://www.vinted.ch/*",
        "https://www.vinted.se/*",
        "https://www.vinted.dk/*",
        "https://www.vinted.fi/*",
        "https://www.vinted.no/*"
      ],
      "js": [
        "lib/heic-to.js",
        "lib/enhance.js",
        "api/api.js",
        "features/heic/heic-import.js",
        "features/creation/wand.js",
        "features/creation/form-tools.js",
        "features/republication/repost.js",
        "panel/panel.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["page/bridge.js"],
      "matches": [
        "https://www.vinted.fr/*",
        "https://www.vinted.com/*",
        "https://www.vinted.it/*",
        "https://www.vinted.es/*",
        "https://www.vinted.de/*",
        "https://www.vinted.co.uk/*",
        "https://www.vinted.nl/*",
        "https://www.vinted.pl/*",
        "https://www.vinted.be/*",
        "https://www.vinted.pt/*",
        "https://www.vinted.lt/*",
        "https://www.vinted.lv/*",
        "https://www.vinted.cz/*",
        "https://www.vinted.sk/*",
        "https://www.vinted.hu/*",
        "https://www.vinted.ro/*",
        "https://www.vinted.at/*",
        "https://www.vinted.ch/*",
        "https://www.vinted.se/*",
        "https://www.vinted.dk/*",
        "https://www.vinted.fi/*",
        "https://www.vinted.no/*"
      ]
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Vinted HEIC Importer",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "96": "icons/icon96.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "96": "icons/icon96.png",
    "128": "icons/icon128.png"
  }
}
