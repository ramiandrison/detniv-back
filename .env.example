# Server
PORT=3001
NODE_ENV=development

# Database
DATABASE_URL="mysql://user:password@localhost:3306/detniv"

# JWT
JWT_ACCESS_SECRET=your_access_secret_here
JWT_REFRESH_SECRET=your_refresh_secret_here
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Mail
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USER=no-reply@example.com
MAIL_PASS=your_mail_password
MAIL_FROM="Detniv <no-reply@example.com>"

# Backblaze B2
# B2_KEY_ID est l'identifiant de la clé applicative, pas l'account ID.
# Capacité nécessaire : writeFiles (restreinte au bucket si possible).
B2_KEY_ID=your_application_key_id
B2_APPLICATION_KEY=your_application_key
B2_BUCKET_ID=your_bucket_id
B2_BUCKET_NAME=your_bucket_name
# URL publique de base du bucket, sans slash final.
# Le bucket doit être public pour que ces URLs soient accessibles.
# Exemple : https://f005.backblazeb2.com/file/detniv-images
B2_PUBLIC_URL=https://f005.backblazeb2.com/file/your_bucket_name

# App
APP_URL=http://localhost:3000
